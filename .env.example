# MongoDB Fleet Healthchecker — Environment Variables
# =====================================================
# Copy with: cp .env.example .env && chmod 600 .env
# Every setting is read from an HC_-prefixed environment variable.

# ── Metadata MongoDB ───────────────────────────────────
# Notes:
#  - Use a cluster SEPARATE from the fleet you are monitoring.
#  - The database name comes from HC_META_MONGO_DB, NOT from the URI path (see app/db.py).
#  - Percent-encode passwords containing special characters:
#    python -c "from urllib.parse import quote; print(quote('p@ss', safe=''))"
#  - Example: mongodb://hc_user:<password>@10.0.0.1:27017/?authSource=admin
HC_META_MONGO_URI=mongodb://localhost:27017/healthchecker
HC_META_MONGO_DB=healthchecker

# ── Scraper (mongodb_exporter /metrics) ────────────────
HC_SCRAPE_CONCURRENCY=10
HC_SCRAPE_TIMEOUT_TOTAL=30
HC_SCRAPE_TIMEOUT_CONNECT=10
HC_SCRAPE_RETRY_COUNT=1
HC_SCRAPE_RETRY_BACKOFF=1.0
HC_SCRAPE_SCHEME=http
HC_SCRAPE_PATH=/metrics
HC_EXPORTER_BASIC_AUTH_USER=
HC_EXPORTER_BASIC_AUTH_PASSWORD=
HC_EXPORTER_TLS_VERIFY=true

# ── Direct MongoDB checks (via each target's mongo_uri) ──
HC_DIRECT_CONNECT_TIMEOUT=10
HC_DIRECT_SERVER_SELECTION_TIMEOUT=5

# ── Slow query profiler (direct mode only; requires the profiler to be enabled) ──
HC_SLOW_QUERY_THRESHOLD_MS=100
HC_SLOW_QUERY_WINDOW_SECONDS=300
HC_SLOW_QUERY_SNAPSHOT_MIN_MS=1000

# ── Scheduler ──────────────────────────────────────────
HC_SCHEDULER_CRON=*/5
HC_SCHEDULER_LOCK_TTL=120

# ── UI / display ───────────────────────────────────────
# IANA zoneinfo name. Empty or invalid falls back to UTC.
HC_DISPLAY_TIMEZONE=UTC

# ── Rules ──────────────────────────────────────────────
HC_RULES_FILE=rules.yml

# ── Alerting ───────────────────────────────────────────
HC_WEBHOOK_URL=
HC_WEBHOOK_FORMAT=generic
HC_ALERT_FOR_CONSECUTIVE=2
HC_ALERT_RENOTIFY_MINUTES=60
HC_ALERT_MIN_SEVERITY=warning
HC_ALERT_SEND_RESOLVE=true
HC_ALERT_STORM_THRESHOLD=5
HC_DASHBOARD_BASE_URL=http://localhost:8000

# ── API / server ───────────────────────────────────────
HC_API_HOST=0.0.0.0
HC_API_PORT=8000
HC_API_RELOAD=false

# ── Logging ────────────────────────────────────────────
HC_LOG_LEVEL=INFO
HC_LOG_JSON=false
